---
interface Props { title: string; steps: { title: string; text: string }[]; soft?: boolean }
const { title, steps, soft = false } = Astro.props;
---
<section class:list={['section', { soft }]}>
  <div class="wrap">
    <h2>{title}</h2>
    <ol class="steps" style={`--n:${steps.length}`}>
      {steps.map((s, i) => (
        <li>
          <span class="num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 24px; }
  @media (max-width: 800px) { .steps { grid-template-columns: 1fr; } }
  .num { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--orange); color: #fff; font-weight: 600; margin-bottom: 14px; }
</style>

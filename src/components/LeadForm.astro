---
/**
 * Lead / waitlist form. Posts to the Cloudflare Pages Function at /api/lead,
 * which creates a lead in Odoo and notifies the right people (see functions/api/lead.ts).
 */
export interface Field {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'textarea' | 'select' | 'checkbox';
  required?: boolean;
  options?: (string | { value: string; label: string })[];
  half?: boolean;
}
interface Props {
  id?: string;
  form: 'apartment' | 'daei' | 'contact' | 'reseller' | 'quote' | 'guide';
  download?: { label: string; href: string };
  lang: string;
  title: string;
  intro?: string;
  fields: Field[];
  submit: string;
  thanks: string;
  error: string;
  consent: string;
}
const { id = 'form', form, lang, title, intro, fields, submit, thanks, error, consent, download } = Astro.props;
import { company } from '../content/ui';
import { legal } from '../content/site';
const AUTO: Record<string, string> = { name: 'name', organisation: 'organization', company: 'organization', email: 'email', phone: 'tel', city: 'address-level2', address: 'street-address', country: 'country-name' };
// Country list in the page language; the value sent to VOOL stays in English.
const ISO = ['EE','LV','LT','FI','SE','NO','DK','IS','DE','AT','CH','NL','BE','LU','FR','IT','ES','PT','PL','CZ','SK','HU','SI','HR','IE','GB','GR','RO','BG','MT','CY'];
const en = new Intl.DisplayNames(['en'], { type: 'region' });
const local = new Intl.DisplayNames([lang === 'no' ? 'nb' : lang], { type: 'region' });
const countries = ISO.map((c) => ({ value: en.of(c)!, label: local.of(c)! })).sort((a, b) => a.label.localeCompare(b.label, lang));
const privacy = [...legal(lang as any), ...legal('en')].find((p) => /privacy|privaat|privat|tietosuoja|datenschutz|prywatno/i.test(p.path + p.title));
---
<div class="form-card" id={id}>
  <h2>{title}</h2>
  {intro && <p class="muted">{intro}</p>}
  <form method="post" action="/api/lead" data-lead-form novalidate>
    <input type="hidden" name="form" value={form} />
    <input type="hidden" name="lang" value={lang} />
    <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="fields">
      {fields.map((f) => (
        f.type === 'checkbox' ? (
          <label class="check full"><input type="checkbox" name={f.name} value="yes" /> <span>{f.label}</span></label>
        ) : (
          <label class:list={[{ full: !f.half }]}>
            <span>{f.label}{f.required && ' *'}</span>
            {f.type === 'textarea' ? (
              <textarea name={f.name} rows="3" required={f.required} autocomplete="off"></textarea>
            ) : f.name === 'country' ? (
              <select name="country" required={f.required} autocomplete="country-name">
                <option value="">–</option>
                {countries.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            ) : f.type === 'select' ? (
              <select name={f.name} required={f.required}>
                <option value="">–</option>
                {f.options?.map((o) => typeof o === 'string' ? <option value={o}>{o}</option> : <option value={o.value}>{o.label}</option>)}
              </select>
            ) : (
              <input type={f.type ?? 'text'} name={f.name} required={f.required} min={f.type === 'number' ? 0 : undefined} autocomplete={AUTO[f.name] ?? 'off'} inputmode={f.type === 'number' ? 'numeric' : undefined} />
            )}
          </label>
        )
      ))}
      <label class="check full"><input type="checkbox" name="consent" value="yes" required /> <span>{consent}{privacy && <> <a href={privacy.path} target="_blank" rel="noopener">{privacy.title} ↗</a></>}</span></label>
    </div>
    <button class="btn" type="submit">{submit}</button>
    <p class="status ok" hidden>{thanks} {download && <a href={download.href} download>{download.label}</a>}</p>
    <p class="status err" hidden role="alert">{error}</p>
  </form>
  <p class="direct"><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a><span aria-hidden="true"> · </span><a href={`mailto:${company.email}`}>{company.email}</a></p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Inline messages instead of the browser's bubbles; the text comes from the browser, in the visitor's language.
      form.querySelectorAll('.field-err').forEach((x) => x.remove());
      const bad = [...form.querySelectorAll<HTMLInputElement>('input, select, textarea')].filter((f) => !f.checkValidity());
      form.querySelectorAll('[aria-invalid]').forEach((f) => f.removeAttribute('aria-invalid'));
      bad.forEach((f, i) => {
        const m = document.createElement('small'); m.className = 'field-err'; m.id = `err-${f.name}`; m.textContent = f.validationMessage;
        f.setAttribute('aria-invalid', 'true'); f.setAttribute('aria-describedby', m.id);
        f.closest('label')!.append(m);
        f.addEventListener('input', () => { if (f.checkValidity()) { m.remove(); f.removeAttribute('aria-invalid'); } });
        if (i === 0) f.focus();
      });
      if (bad.length) return;
      const btn = form.querySelector('button');
      const ok = form.querySelector<HTMLElement>('.status.ok')!;
      const err = form.querySelector<HTMLElement>('.status.err')!;
      ok.hidden = err.hidden = true;
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelector('.fields')!.setAttribute('hidden', '');
        btn?.setAttribute('hidden', '');
        ok.hidden = false;
        (window as any).plausible?.('Lead', { props: { form: (form.elements.namedItem('form') as HTMLInputElement)?.value } });
      } catch {
        err.hidden = false;
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

<style>
  .form-card { background: #fff; border-radius: var(--radius); padding: 36px; box-shadow: 0 20px 60px rgba(0,0,0,.08); color: var(--ink); }
  .form-card h2 { font-size: 1.6rem; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; margin: 20px 0 22px; }
  .fields[hidden] { display: none; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: .88rem; font-weight: 500; min-width: 0; }
  input:not([type=checkbox]), select, textarea { width: 100%; min-width: 0; }
  label.full { grid-column: 1 / -1; }
  input, select, textarea { font: inherit; font-size: 16px; font-weight: 400; padding: .7em .9em; min-height: 48px; border: 1px solid var(--field); border-radius: 10px; background: #fff; color: var(--ink); }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--orange); outline-offset: 1px; border-color: transparent; }
  .check { flex-direction: row; align-items: flex-start; gap: 10px; font-weight: 400; color: var(--grey); }
  .check input { margin-top: 2px; accent-color: var(--orange-btn); width: 22px; height: 22px; min-height: 0; flex: none; padding: 0; }
  .check a { color: var(--orange-text); }
  .check { flex-wrap: wrap; } .check span { flex: 1; }
  :global(.field-err) { color: #b3261e; font-weight: 400; font-size: .84rem; flex-basis: 100%; }
  :global([aria-invalid="true"]) { border-color: #b3261e !important; }
  .direct { margin: 22px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: .95rem; }
  .direct a { color: var(--ink); font-weight: 500; text-decoration: none; display: inline-block; padding: 6px 0; }
  .direct a:hover { color: var(--orange-text); }
  .hp { position: absolute; left: -9999px; }
  .status { margin: 16px 0 0; font-weight: 500; }
  .status.ok { color: var(--green); }
  .status.err { color: #b3261e; }
  @media (max-width: 560px) { .fields { grid-template-columns: 1fr; } .form-card { padding: 24px; } }
</style>

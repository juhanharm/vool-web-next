---
import Base from '../layouts/Base.astro';
import Steps from './Steps.astro';
import Faq from './Faq.astro';
import LeadForm from './LeadForm.astro';
import { daei } from '../content/daei';

interface Props { lang: 'lt' | 'en' }
const { lang } = Astro.props;
const c = daei[lang];
const locale = lang === 'lt' ? 'lt-LT' : 'en-IE';
---
<Base lang={lang} title={c.meta.title} description={c.meta.description}
  alternates={{ lt: '/lt/daei/', en: '/daei/' }}>

  <section class="section dark hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1>{c.hero.title}</h1>
        <p class="lead">{c.hero.lead}</p>
        <div class="rate">
          <div class="big-number">{c.hero.rate}</div>
          <div class="rate-label">{c.hero.rateLabel}</div>
        </div>
        <ul class="facts">{c.hero.facts.map((f) => <li>{f}</li>)}</ul>
      </div>
      <LeadForm id="waitlist" form="daei" lang={lang} title={c.form.title} intro={c.form.intro}
        fields={c.form.fields as any} submit={c.form.submit} thanks={c.form.thanks}
        error={c.form.error} consent={c.form.consent} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{c.who.title}</h2>
      <div class="grid c3" style="margin-top:28px">
        {c.who.items.map((w) => <div class="card"><h3>{w.title}</h3><p class="muted">{w.text}</p></div>)}
      </div>
    </div>
  </section>

  <Steps title={c.steps.title} steps={c.steps.items as any} soft />

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>{c.need.title}</h2>
        <ul class="checks">{c.need.items.map((n) => <li>{n}</li>)}</ul>
        <p class="small muted">{c.need.note}</p>
        <h2 style="margin-top:48px">{c.table.title}</h2>
        <table class="t">
          <thead><tr>{c.table.head.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{c.table.rows.map((r) => <tr>{r.map((x) => <td>{x}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <div class="card">
        <h3>{c.terms.title}</h3>
        <table class="t kv">{c.terms.rows.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</table>
        <p class="small muted">{c.terms.note}</p>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap calc" data-locale={locale}>
      <h2>{c.calc.title}</h2>
      <label>
        <span>{c.calc.kmLabel}: <strong data-km>20 000</strong></span>
        <input type="range" min="5000" max="50000" step="1000" value="20000" data-range />
      </label>
      <div class="calc-out"><span class="big-number" data-eur>140 €</span> <span class="muted">{c.calc.result}</span></div>
      <p class="small muted">{c.calc.note}</p>
    </div>
  </section>

  <Faq title={c.faq.title} items={c.faq.items as any} />
</Base>

<script>
  const box = document.querySelector<HTMLElement>('.calc');
  if (box) {
    const locale = box.dataset.locale || 'en';
    const range = box.querySelector<HTMLInputElement>('[data-range]')!;
    const km = box.querySelector('[data-km]')!;
    const eur = box.querySelector('[data-eur]')!;
    const fmt = new Intl.NumberFormat(locale);
    const money = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const update = () => {
      const v = Number(range.value);
      km.textContent = fmt.format(v);
      eur.textContent = money.format((v / 100) * 18 * 0.039);
    };
    range.addEventListener('input', update);
    update();
  }
</script>

<style>
  .hero { padding-top: 72px; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .rate { display: flex; align-items: baseline; gap: 14px; margin: 28px 0 8px; }
  .rate-label { color: #cfcfcf; }
  .facts { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .facts li { border: 1px solid #4a4a4a; border-radius: 999px; padding: 6px 14px; font-size: .88rem; color: #e6e6e6; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; gap: 32px; } }
  .checks { list-style: none; padding: 0; margin: 18px 0; }
  .checks li { padding: 7px 0 7px 30px; position: relative; }
  .checks li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }
  .t { width: 100%; border-collapse: collapse; margin: 14px 0; }
  .t th, .t td { text-align: left; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); font-weight: 300; font-size: .93rem; vertical-align: top; }
  .t thead th { font-weight: 500; }
  .t.kv th { width: 36%; color: var(--grey); }
  .calc { max-width: 720px; }
  .calc label { display: flex; flex-direction: column; gap: 12px; margin: 24px 0; }
  .calc input[type=range] { accent-color: var(--orange); width: 100%; }
  .calc-out { display: flex; align-items: baseline; gap: 12px; }
</style>

---
/** Illustration: the car waits through the evening price peak and charges in the cheapest hours. Prices are an example, not live data. */
interface Props { title: string; text: string; note: string; labels: { peak: string; charging: string; waiting: string; ready: string } }
const { title, text, note, labels } = Astro.props;
const hours = [18, 19, 20, 21, 22, 23, 0, 1, 2, 3, 4, 5, 6, 7];
const price = [21, 26, 24, 17, 12, 8, 5, 4, 3, 3, 4, 6, 11, 16]; // ct/kWh, example evening and night
const cheapest = [...price].map((p, i) => [p, i]).sort((a, b) => a[0] - b[0]).slice(0, 5).map((x) => x[1]);
const max = Math.max(...price);
---
<section class="section soft">
  <div class="wrap night">
    <div>
      <h2>{title}</h2>
      <p class="muted">{text}</p>
      <ul class="legend">
        <li><i class="dot wait"></i>{labels.waiting}</li>
        <li><i class="dot charge"></i>{labels.charging}</li>
      </ul>
    </div>
    <div class="chart" role="img" aria-label={title}>
      <div class="bars">
        {price.map((p, i) => (
          <div class:list={['bar', { on: cheapest.includes(i) }]} style={`height:${Math.round((p / max) * 100)}%`}>
            <span class="val">{p}</span>
          </div>
        ))}
      </div>
      <div class="axis">{hours.map((h) => <span>{String(h).padStart(2, '0')}</span>)}</div>
      <div class="marks"><span>↑ {labels.peak}</span><span>{labels.ready} ↑</span></div>
      <p class="small muted">{note}</p>
    </div>
  </div>
</section>
<style>
  .night { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .night { grid-template-columns: 1fr; gap: 28px; } }
  .chart { background: #fff; border-radius: var(--radius); padding: 28px 24px 16px; }
  .bars { display: grid; grid-template-columns: repeat(14, 1fr); gap: 6px; align-items: end; height: 190px; }
  .bar { background: var(--line); border-radius: 6px 6px 0 0; position: relative; min-height: 8px; }
  .bar.on { background: var(--orange); }
  .val { position: absolute; top: -20px; left: 0; right: 0; text-align: center; font-size: .7rem; color: var(--grey); }
  .axis { display: grid; grid-template-columns: repeat(14, 1fr); gap: 6px; margin-top: 6px; font-size: .72rem; color: var(--grey); text-align: center; }
  .marks { display: flex; justify-content: space-between; font-size: .78rem; margin: 10px 0 6px; color: var(--grey); }
  .legend { list-style: none; padding: 0; margin: 18px 0 0; display: flex; gap: 20px; font-size: .9rem; }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 8px; background: var(--line); }
  .dot.charge { background: var(--orange); }
</style>

---
import Base from '../layouts/Base.astro';
import ChargerArt from './ChargerArt.astro';
import { home } from '../content/home';
import { RESELLER_URL, ui, type Lang } from '../content/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
---
<Base lang={lang} title={c.meta.title} description={c.meta.description}
  alternates={{ en: '/', et: '/et/', lt: '/lt/' }}>

  <div class="promos">
    {c.promos.map((p: any) => (
      <a class="promo" href={p.href}>
        <span class="badge">{p.badge}</span>
        <span>{p.text}</span>
        <strong>{p.cta} →</strong>
      </a>
    ))}
  </div>

  <section class="hero section">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1>{c.hero.title}</h1>
        <p class="lead">{c.hero.lead}</p>
        <div class="btn-row">
          <a class="btn" href={c.hero.primary.href}>{c.hero.primary.label}</a>
          <a class="btn ghost" href={c.hero.secondary.href}>{c.hero.secondary.label}</a>
        </div>
      </div>
      <ChargerArt />
    </div>
  </section>

  <section class="section soft" id="products">
    <div class="wrap">
      <span class="eyebrow">{c.products.eyebrow}</span>
      <h2>{c.products.title}</h2>
      <div class="grid c4" style="margin-top:32px">
        {c.products.items.map((p: any) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p class="muted">{p.tag}</p>
            <ul>{p.points.map((x: string) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{c.solutions.eyebrow}</span>
      <h2>{c.solutions.title}</h2>
      <div class="grid c4" style="margin-top:32px">
        {c.solutions.items.map((s: any) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
            {s.href && <a class="more" href={s.href}>{s.more}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark" id="buy">
    <div class="wrap buy">
      <div>
        <h2>{c.buy.title}</h2>
        <p class="lead">{c.buy.lead}</p>
      </div>
      <div class="btn-row">
        <a class="btn" href={c.buy.primary.href}>{c.buy.primary.label}</a>
        <a class="btn ghost" href={c.buy.secondary.href}>{c.buy.secondary.label}</a>
        <a class="btn ghost" href={RESELLER_URL}>{ui[lang].reseller}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .promos { display: flex; flex-direction: column; }
  .promo { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; padding: 12px 24px; background: var(--ink); color: #fff; text-decoration: none; font-size: .92rem; border-bottom: 1px solid #3a3a3a; }
  .promo strong { color: var(--orange); font-weight: 500; }
  .promo .badge { background: var(--orange); color: #fff; }
  .hero { padding-top: 72px; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
  .buy { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; }
  .buy .btn.ghost { color: #fff; }
  @media (max-width: 860px) { .buy { grid-template-columns: 1fr; } }
</style>

---
/** Simple illustrative wallbox drawing (placeholder until real product photos are added). */
interface Props { glow?: string }
const { glow = '#eb4e20' } = Astro.props;
---
<svg viewBox="0 0 360 420" role="img" aria-label="VOOL charger illustration" class="art">
  <defs>
    <linearGradient id="body" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e9e9e9" />
    </linearGradient>
    <radialGradient id="halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color={glow} stop-opacity=".35" />
      <stop offset="1" stop-color={glow} stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="180" cy="170" r="170" fill="url(#halo)" />
  <rect x="90" y="40" width="180" height="260" rx="38" fill="url(#body)" stroke="#d6d6d6" stroke-width="2" />
  <rect x="122" y="88" width="116" height="10" rx="5" fill={glow} />
  <text x="180" y="200" text-anchor="middle" font-family="Poppins, Arial, sans-serif" font-size="28" font-weight="600" letter-spacing="6" fill="#282828">VOOL</text>
  <path d="M180 300 C 180 360, 250 360, 260 400" fill="none" stroke="#282828" stroke-width="14" stroke-linecap="round" />
  <rect x="244" y="388" width="44" height="26" rx="8" fill="#282828" />
</svg>
<style>.art { width: 100%; max-width: 380px; margin: 0 auto; }</style>

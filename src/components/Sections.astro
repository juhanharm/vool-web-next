---
/**
 * Renders a page from a list of section blocks (see src/content/pages.ts).
 * Translating a page = translating its data; the layout stays the same.
 */
import Steps from './Steps.astro';
import Faq from './Faq.astro';
import Configurator from './Configurator.astro';
import { tr } from '../content/pagesStore';
import LeadForm from './LeadForm.astro';
import NightCharge from './NightCharge.astro';
import CostCompare from './CostCompare.astro';
import LoadDemo from './LoadDemo.astro';
import { posts, blogIndex, dateKey } from '../content/site';

// Latest articles for the "news" block: only articles less than a year old.
const now = new Date();
const yearAgo = (now.getFullYear() - 1) * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
const latest = (l: string) => posts(l as any).filter((p) => dateKey(p.date) >= yearAgo).slice(0, 3);

interface Props { sections: any[]; lang: string }
const { sections, lang } = Astro.props;
---
{sections.map((s, i) => (
  <>
    {s.type === 'hero' && s.variant === 'full' && (
      <section class="hero-full">
        <img class="hero-bg" src={s.image} alt={s.alt ?? ''} loading="eager" fetchpriority="high" />
        <div class="wrap">
          <div class="hero-full-text">
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h1>{s.title}</h1>
            <p class="lead">{s.lead}</p>
            {s.cta && <div class="btn-row">{s.cta.map((b: any, j: number) => <a class:list={['btn', { ghost: j > 0 }]} href={b.href}>{b.label}</a>)}</div>}
            {s.facts && <ul class="facts">{s.facts.map((f: string) => <li>{f}</li>)}</ul>}
          </div>
        </div>
      </section>
    )}

    {s.type === 'hero' && s.variant !== 'full' && (
      <section class:list={['hero', { dark: s.dark }]}>
        <div class="wrap hero-grid">
          <div class="hero-text">
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h1>{s.title}</h1>
            <p class="lead">{s.lead}</p>
            {s.cta && <div class="btn-row">{s.cta.map((b: any, j: number) => <a class:list={['btn', { ghost: j > 0 }]} href={b.href}>{b.label}</a>)}</div>}
            {s.facts && <ul class="facts">{s.facts.map((f: string) => <li>{f}</li>)}</ul>}
          </div>
          {s.image && <div class="photo hero-photo"><img src={s.image} alt={s.alt ?? ''} loading="eager" /></div>}
        </div>
      </section>
    )}

    {s.type === 'cards' && s.variant === 'photo' && (
      <section class="section" id={s.id}>
        <div class="wrap">
          {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
          <h2>{s.title}</h2>
          <div class="pcards">
            {s.items.map((c: any) => (
              <a class="pcard" href={c.href}>
                <img src={c.image} alt="" loading="lazy" />
                <div><h3>{c.title}</h3>{c.text && <p>{c.text}</p>}<span class="go" aria-hidden="true">→</span></div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {s.type === 'cards' && s.variant === 'showcase' && (
      <section class="section" id={s.id}>
        <div class="wrap">
          {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
          <h2>{s.title}</h2>
          <div class="show">
            {s.items.map((c: any, j: number) => (
              <a class:list={['tile', { dark: j > 1, wide: j === 0 || j === 3 }]} href={c.href}>
                <div class="tile-text"><h3>{c.title}</h3>{c.text && <p>{c.text}</p>}<span class="more">{c.more ?? tr(lang, 'Learn more')} →</span></div>
                <img src={c.image} alt="" loading="lazy" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {s.type === 'cards' && s.variant === 'proof' && (
      <section class="section dark proof" id={s.id}>
        <div class="wrap">
          {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
          <h2>{s.title}</h2>
          <div class="grid c3" style="margin-top:36px">
            {s.items.map((c: any) => (
              <a class="proof-card" href={c.href}><h3>{c.title}</h3>{c.text && <p>{c.text}</p>}<span class="more">{c.more ?? tr(lang, 'Learn more')} →</span></a>
            ))}
          </div>
        </div>
      </section>
    )}

    {s.type === 'cards' && s.variant === 'compact' && (
      <section class="section" id={s.id}>
        <div class="wrap">
          {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
          <h2>{s.title}</h2>
          <ul class="linklist">{s.items.map((c: any) => <li><a href={c.href}>{c.title}<span>→</span></a></li>)}</ul>
        </div>
      </section>
    )}

    {s.type === 'strip' && (
      <section class="strip" aria-hidden="true">{s.items.map((i: any) => <img src={i.image} alt="" loading="lazy" />)}</section>
    )}

    {s.type === 'cards' && !s.variant && (
      <section class:list={['section', { soft: s.soft }]} id={s.id}>
        <div class="wrap">
          {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
          <h2>{s.title}</h2>
          {s.lead && <p class="lead">{s.lead}</p>}
          <div class={`grid c${s.cols ?? 3}`} style="margin-top:32px">
            {s.items.map((c: any) => (
              <div class:list={['card', { 'has-img': c.image }]}>
                {c.image && <div class="photo card-photo"><img src={c.image} alt="" loading="lazy" /></div>}
                <h3>{c.title}</h3>
                {c.text && <p class="muted">{c.text}</p>}
                {c.points && <ul>{c.points.map((p: string) => <li>{p}</li>)}</ul>}
                {c.href && <a class="more" href={c.href}>{c.more ?? tr(lang, 'Learn more')} →</a>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {s.type === 'split' && (
      <section class:list={['section', { soft: s.soft, bleed: s.variant === 'bleed' }]} id={s.id}>
        <div class:list={['wrap', 'split', { flip: s.flip }]}>
          <div class="photo"><img src={s.image} alt={s.alt ?? ''} loading="lazy" /></div>
          <div>
            {s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}
            <h2>{s.title}</h2>
            {s.text && <p class="muted">{s.text}</p>}
            {s.points && <ul class="checks">{s.points.map((p: string) => <li>{p}</li>)}</ul>}
            {s.cta && <div class="btn-row">{s.cta.map((b: any, j: number) => <a class:list={['btn', { ghost: j > 0 }]} href={b.href}>{b.label}</a>)}</div>}
          </div>
        </div>
      </section>
    )}

    {s.type === 'stats' && (
      <section class="stats"><div class="wrap stats-in">
        {s.items.map((x: any) => <div><div class="big-number">{x.value}</div><p>{x.label}</p></div>)}
      </div></section>
    )}

    {s.type === 'logos' && (
      <section class="section logos"><div class="wrap">
        <p class="eyebrow">{s.title}</p>
        <div class="logo-row">{s.items.map((l: any) => <img src={l.src} alt={l.name} loading="lazy" />)}</div>
      </div></section>
    )}

    {s.type === 'news' && (s.pins?.[lang] || latest(lang).length > 0) && (
      <section class="section soft news"><div class="wrap">
        <div class="news-head"><h2>{s.title}</h2>{blogIndex(lang as any) && <a class="btn ghost" href={blogIndex(lang as any)}>{s.more} →</a>}</div>
        {s.pins?.[lang] && (
          <a class="card pin" href={s.pins[lang].href}>
            <div class="photo"><img src={s.pins[lang].image} alt="" loading="lazy" /></div>
            <div>
              <span class="badge">{tr(lang, 'News')}</span>
              <h3>{s.pins[lang].title}</h3>
              <p class="muted">{s.pins[lang].text}</p>
              <span class="btn">{s.pins[lang].more} →</span>
            </div>
          </a>
        )}
        {latest(lang).length > 0 && (
          <div class="grid c3" style="margin-top:28px">
            {latest(lang).map((p) => (
              <a class="card has-img news-card" href={p.path}>
                <div class="photo card-photo">{p.image && <img src={p.image} alt="" loading="lazy" />}</div>
                <p class="small muted">{p.date}</p>
                <h3>{p.title}</h3>
              </a>
            ))}
          </div>
        )}
      </div></section>
    )}

    {s.type === 'night' && <NightCharge title={s.title} text={s.text} note={s.note} labels={s.labels} />}
    {s.type === 'cost' && <CostCompare title={s.title} lead={s.lead} note={s.note} labels={s.labels} locale={s.locale} />}

    {s.type === 'demo' && (
      <section class:list={['section', { soft: s.soft }]} id={s.id}><div class="wrap">
        <h2>{s.title}</h2>{s.lead && <p class="lead" style="margin-bottom:28px">{s.lead}</p>}
        <LoadDemo labels={s.labels} />
      </div></section>
    )}

    {s.type === 'table' && (
      <section class:list={['section', { soft: s.soft }]}><div class="wrap">
        <h2>{s.title}</h2>{s.lead && <p class="lead">{s.lead}</p>}
        <div class="cmp-wrap"><table class="cmp">
          <thead><tr>{s.head.map((h: string, j: number) => <th class:list={[{ us: j === s.head.length - 1 }]}>{h}</th>)}</tr></thead>
          <tbody>{s.rows.map((r: string[]) => <tr>{r.map((c, j) => j === 0 ? <th>{c}</th> : <td class:list={[{ us: j === r.length - 1 }]}>{c}</td>)}</tr>)}</tbody>
        </table></div>
        {s.note && <p class="small muted">{s.note}</p>}
      </div></section>
    )}

    {s.type === 'prose' && (
      <section class:list={['section', { soft: s.soft }]} id={s.id}><div class="wrap prose">
        <h2>{s.title}</h2>
        {s.paragraphs?.map((t: string) => <p set:html={t} />)}
        {s.points && <ul>{s.points.map((t: string) => <li set:html={t} />)}</ul>}
        {s.box && <blockquote><strong>{s.box.title}</strong><br /><span set:html={s.box.text} /></blockquote>}
        {s.sources && <p class="small muted">{s.sourcesLabel ?? 'Sources'}: {s.sources.map((x: any, j: number) => <>{j > 0 && ' · '}<a href={x.href} rel="noopener">{x.label}</a></>)}</p>}
      </div></section>
    )}

    {s.type === 'steps' && <Steps title={s.title} steps={s.items} soft={s.soft} />}

    {s.type === 'specs' && (
      <section class:list={['section', { soft: s.soft }]}>
        <div class="wrap specs">
          <h2>{s.title}</h2>
          <table>{s.rows.map(([k, v]: string[]) => <tr><th>{k}</th><td>{v}</td></tr>)}</table>
          {s.note && <p class="small muted">{s.note}</p>}
          {s.links && <div class="btn-row">{s.links.map((b: any) => <a class="btn ghost" href={b.href}>{b.label}</a>)}</div>}
        </div>
      </section>
    )}

    {s.type === 'links' && (
      <section class:list={['section', { soft: s.soft }]}>
        <div class="wrap">
          <h2>{s.title}</h2>
          {s.lead && <p class="lead">{s.lead}</p>}
          <ul class="linklist">{s.items.map((l: any) => <li><a href={l.href} rel="noopener">{l.label}<span>↗</span></a></li>)}</ul>
        </div>
      </section>
    )}

    {s.type === 'faq' && <Faq title={s.title} items={s.items} />}

    {s.type === 'cta' && (
      <section class:list={['section', 'dark', { orange: s.variant === 'orange' }]}>
        <div class="wrap cta">
          <div><h2>{s.title}</h2>{s.lead && <p class="lead">{s.lead}</p>}</div>
          <div class="btn-row">{s.buttons.map((b: any, j: number) => <a class:list={['btn', { ghost: j > 0 }]} href={b.href}>{b.label}</a>)}</div>
        </div>
      </section>
    )}

    {s.type === 'configurator' && <Configurator id={s.id} title={s.title} lead={s.lead} thanks={s.thanks} error={s.error} consent={s.consent} lang={lang} />}

    {s.type === 'form' && (
      <section class="section dark">
        <div class="wrap" style="max-width:760px">
          <LeadForm id="form" form={s.form} lang={lang} title={s.title} intro={s.intro} fields={s.fields}
            submit={s.submit} thanks={s.thanks} error={s.error} consent={s.consent} download={s.download} />
        </div>
      </section>
    )}
  </>
))}

<style>
  .stats { background: var(--ink); color: #fff; padding: 36px 0; }
  .stats-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .stats .big-number { font-size: clamp(2rem, 4vw, 3rem); }
  .stats p { margin: 6px 0 0; color: #cfcfcf; font-size: .92rem; }
  @media (max-width: 760px) { .stats-in { grid-template-columns: 1fr 1fr; } }
  .logos { padding: 48px 0; }
  .logo-row { display: flex; flex-wrap: wrap; gap: 28px 64px; align-items: center; margin-top: 12px; }
  .logo-row img { height: 38px; width: auto; max-width: 150px; object-fit: contain; filter: grayscale(1); opacity: .65; transition: filter .2s, opacity .2s; }
  .logo-row img:hover { filter: none; opacity: 1; }
  .cmp-wrap { overflow-x: auto; margin: 28px 0 12px; border-radius: 14px; background: linear-gradient(to right, #fff 30%, rgba(255,255,255,0)) left / 40px 100% no-repeat local, linear-gradient(to left, #fff 30%, rgba(255,255,255,0)) right / 40px 100% no-repeat local, linear-gradient(to left, rgba(0,0,0,.16), rgba(0,0,0,0)) right / 18px 100% no-repeat scroll, #fff; }
  .cmp { border-collapse: collapse; width: 100%; min-width: 760px; background: transparent; }
  .cmp th, .cmp td { padding: 14px 16px; border-bottom: 1px solid var(--line); text-align: left; font-weight: 400; font-size: .93rem; vertical-align: top; }
  .cmp thead th { font-weight: 500; background: var(--soft); }
  .cmp tbody th { font-weight: 400; width: 26%; }
  .cmp .us { background: rgba(235,78,32,.07); font-weight: 500; }
  .cmp thead .us { background: var(--orange-btn); color: #fff; }
  .hero { padding: 72px 0 80px; }
  .hero.dark { background: var(--ink); color: #fff; }
  .hero.dark .lead { color: #cfcfcf; }
  .hero.dark .btn.ghost { color: #fff; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: center; }
  /* heroes without a picture use the full width instead of leaving the right half empty */
  .hero-grid:not(:has(.hero-photo)) { grid-template-columns: 1fr; }
  .hero-grid:not(:has(.hero-photo)) .hero-text { max-width: 860px; }
  .hero:not(.dark):not(:has(.hero-photo)) { background: var(--cream); }
  .hero h1 { font-size: clamp(2.3rem, 4.6vw, 3.9rem); }
  .hero .lead { max-width: 34em; }
  .hero-photo { aspect-ratio: 5 / 4; box-shadow: 0 30px 70px rgba(0,0,0,.14); }
  .facts { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .facts li { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: .86rem; }
  .hero.dark .facts li { border-color: #4a4a4a; color: #e6e6e6; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .split .photo { aspect-ratio: 4 / 3; }
  .split.flip .photo { order: 2; }
  @media (max-width: 860px) { .hero-grid, .split { grid-template-columns: 1fr; gap: 32px; } .split.flip .photo { order: 0; } .hero { padding: 48px 0 56px; } }
  .checks { list-style: none; padding: 0; margin: 18px 0 0; }
  .checks li { padding: 7px 0 7px 30px; position: relative; }
  .checks li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }
  .card.has-img { padding: 0 0 24px; overflow: hidden; }
  .card.has-img > :not(.photo) { margin-left: 24px; margin-right: 24px; }
  .card-photo { aspect-ratio: 16 / 10; border-radius: 0; margin-bottom: 20px; }
  .specs { max-width: 820px; }
  .specs table { width: 100%; border-collapse: collapse; margin: 20px 0; }
  .specs th, .specs td { text-align: left; padding: 12px 0; border-bottom: 1px solid var(--line); font-weight: 400; vertical-align: top; }
  .specs th { width: 42%; color: var(--grey); }
  .specs td { font-weight: 500; }
  .linklist { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
  .linklist a { display: flex; justify-content: space-between; gap: 12px; padding: 16px 20px; background: #fff; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; }
  .linklist a:hover { border-color: var(--orange); }
  .linklist span { color: var(--orange); }
  .news-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .news-head h2 { margin: 0; }
  .news-card { text-decoration: none; display: block; }
  .pin { display: grid; grid-template-columns: 1fr 1.2fr; gap: 36px; align-items: center; padding: 18px; margin-top: 28px; text-decoration: none; }
  .pin .photo { aspect-ratio: 16 / 10; }
  .pin h3 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: .5em 0 .4em; }
  .pin .btn { margin-top: .4em; }
  .pin:hover { box-shadow: 0 14px 34px rgba(0,0,0,.08); }
  @media (max-width: 760px) { .pin { grid-template-columns: 1fr; gap: 16px; } }
  .news { padding: 64px 0; }
  .news-card p { margin-bottom: .3em; }
  .news-card:hover h3 { color: var(--orange-text); }
  .cta { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  .cta .btn.ghost { color: #fff; }
  .cta .btn-row { margin-top: 0; }
  @media (max-width: 860px) { .cta { grid-template-columns: 1fr; } }

  /* --- visual home page, Nov 2026 --- */
  .hero-full { position: relative; min-height: min(86vh, 880px); display: flex; align-items: center; color: #fff; background: #1b1d1f; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; }
  .hero-full::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,12,14,.86) 0%, rgba(10,12,14,.62) 38%, rgba(10,12,14,0) 72%); }
  .hero-full .wrap { position: relative; z-index: 1; width: 100%; padding-top: 72px; padding-bottom: 72px; }
  .hero-full-text { max-width: 760px; }
  .hero-full h1 { font-size: clamp(2.5rem, 6.1vw, 5.9rem); line-height: 1.02; letter-spacing: -0.025em; }
  .hero-full .lead { color: #e4e4e4; max-width: 33em; font-size: 1.2rem; }
  .hero-full .eyebrow { color: #ff7a52; }
  .hero-full .btn.ghost { color: #fff; }
  .hero-full .btn { padding: 1em 1.8em; font-size: 1.02rem; }
  .hero-full .facts li { border-color: rgba(255,255,255,.4); color: #fff; }
  @media (max-width: 760px) { .hero-full { min-height: 82vh; align-items: flex-end; } .hero-full::after { background: linear-gradient(0deg, rgba(10,12,14,.92) 30%, rgba(10,12,14,.35) 75%, rgba(10,12,14,.1)); } .hero-bg { object-position: 70% 30%; } .hero-full .wrap { padding-top: 40px; padding-bottom: 36px; } .hero-full .lead { font-size: 1.05rem; } }
  .pcards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 32px; }
  .pcard { position: relative; aspect-ratio: 3 / 4.2; border-radius: 22px; overflow: hidden; color: #fff; text-decoration: none; display: flex; align-items: flex-end; background: var(--ink); }
  .pcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .pcard:hover img { transform: scale(1.05); }
  .pcard::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.82) 0%, rgba(0,0,0,.25) 48%, rgba(0,0,0,0) 70%); }
  .pcard > div { position: relative; z-index: 1; padding: 24px; width: 100%; }
  .pcard h3 { font-size: 1.6rem; margin: 0 0 .3em; }
  .pcard p { margin: 0; font-size: .95rem; color: #ececec; max-width: 22em; }
  .pcard .go { position: absolute; right: 22px; top: -8px; width: 42px; height: 42px; border-radius: 50%; background: #fff; color: var(--ink); display: grid; place-items: center; font-size: 1.1rem; transform: translateY(-100%); }
  @media (max-width: 1000px) { .pcards { grid-template-columns: 1fr 1fr; } .pcard { aspect-ratio: 4 / 4.4; } }
  @media (max-width: 560px) { .pcards { grid-template-columns: 1fr; } .pcard { aspect-ratio: 4 / 3.4; } }
  .show { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px; }
  .tile { background: #f5f5f5; border-radius: 26px; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; min-height: 520px; color: var(--ink); transition: transform .2s; }
  .tile:hover { transform: translateY(-3px); }
  .tile.wide { grid-column: span 2; }
  .tile.dark { background: #000; color: #fff; }
  .tile-text { padding: 36px 36px 0; }
  .tile h3 { font-size: clamp(1.7rem, 2.6vw, 2.3rem); margin-bottom: .35em; }
  .tile p { margin: 0 0 .8em; color: var(--grey); max-width: 28em; }
  .tile.dark p { color: #c9c9c9; }
  .tile .more { font-weight: 500; color: var(--orange-text); }
  .tile.dark .more { color: #ff7a52; }
  .tile img { flex: 1; min-height: 0; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; margin-top: 12px; }
  .tile.wide img { object-fit: cover; object-position: center; }
  .tile.dark img { object-fit: contain; object-position: center; padding: 0 20px 20px; max-height: 380px; }
  @media (max-width: 900px) { .show { grid-template-columns: 1fr; } .tile.wide { grid-column: auto; } .tile { min-height: 420px; } .tile-text { padding: 26px 24px 0; } }

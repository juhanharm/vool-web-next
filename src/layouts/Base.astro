---
import '../styles/global.css';
import { ui, nav, langNames, homeOf, company, RESELLER_URL, type Lang } from '../content/ui';
import { blogIndex, legal } from '../content/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The same page in other languages, e.g. { en: '/daei/', lt: '/lt/daei/' } */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
}
const { lang, title, description, alternates = {}, image } = Astro.props;
const t = ui[lang];
const items = [...nav[lang]];
const blog = blogIndex(lang);
if (lang !== 'en' && blog) items.push({ label: t.blog, href: blog });
const langs = (Object.keys(langNames) as Lang[]).map((l) => ({ code: l, href: alternates[l] ?? homeOf(l) }));
const legalPages = legal(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/TWKEverett-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && <script defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="logo" href={homeOf(lang)} aria-label="VOOL"><img src="/logo.svg" alt="VOOL" width="76" height="20" /></a>
        <input type="checkbox" id="menu" class="menu-toggle" aria-label="Menu" />
        <label for="menu" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>
        <nav class="nav" aria-label="Main">
          {items.map((n) => n.children ? (
            <div class="drop">
              <button type="button">{n.label}</button>
              <div class="panel">
                {n.children.map((c) => <a href={c.href}><strong>{c.label}</strong>{c.note && <span>{c.note}</span>}</a>)}
              </div>
            </div>
          ) : <a class="link" href={n.href}>{n.label}</a>)}
          <div class="right">
            <div class="langs">
              {langs.map((l) => <a href={l.href} class={l.code === lang ? 'on' : ''} hreflang={l.code}>{langNames[l.code]}</a>)}
            </div>
            <a class="btn ghost small-btn" href={RESELLER_URL}>{t.reseller}</a>
            <a class="btn small-btn" href="https://app.vool.com">{t.login}</a>
          </div>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="about">
          <img src="/logo.svg" alt="VOOL" width="76" height="20" />
          <p class="muted">{t.tagline}</p>
          <p class="muted small">{company.name} · {company.address}<br />
            <a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a> · <a href={`mailto:${company.email}`}>{company.email}</a></p>
          <p class="small"><a href={company.linkedin}>LinkedIn</a> · <a href={company.instagram}>Instagram</a></p>
        </div>
        {items.filter((n) => n.children).map((n) => (
          <div>
            <h4>{n.label}</h4>
            <ul>{n.children!.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
          </div>
        ))}
        {legalPages.length > 0 && (
          <div>
            <h4>{t.legal}</h4>
            <ul>{legalPages.map((p) => <li><a href={p.path}>{p.title.length > 44 ? p.title.slice(0, 42) + '…' : p.title}</a></li>)}</ul>
          </div>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .top { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 28px; height: 72px; }
  .logo img { height: 20px; width: auto; }
  .nav { display: flex; align-items: center; gap: 4px; flex: 1; }
  .nav .link, .drop > button { font: inherit; font-weight: 400; background: none; border: 0; cursor: pointer; text-decoration: none; color: var(--ink); font-size: .93rem; padding: 10px 12px; border-radius: 8px; }
  .nav .link:hover, .drop:hover > button { background: var(--soft); }
  .drop { position: relative; }
  .panel { display: none; position: absolute; top: 100%; left: 0; min-width: 280px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px; box-shadow: 0 18px 40px rgba(0,0,0,.1); }
  .drop:hover .panel, .drop:focus-within .panel { display: block; }
  .panel a { display: flex; flex-direction: column; padding: 10px 12px; border-radius: 8px; text-decoration: none; }
  .panel a:hover { background: var(--soft); }
  .panel span { font-size: .82rem; color: var(--grey); }
  .right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  .langs { display: flex; gap: 2px; margin-right: 6px; }
  .langs a { text-decoration: none; font-size: .78rem; font-weight: 500; color: var(--grey); padding: 4px 6px; border-radius: 6px; }
  .langs a.on { color: var(--ink); background: var(--soft); }
  .small-btn { padding: .55em 1.1em; font-size: .88rem; white-space: nowrap; }
  .menu-toggle, .burger { display: none; }
  @media (max-width: 1100px) {
    .burger { display: flex; flex-direction: column; gap: 5px; margin-left: auto; cursor: pointer; padding: 10px; }
    .burger span { width: 24px; height: 2px; background: var(--ink); }
    .nav { display: none; position: absolute; top: 72px; left: 0; right: 0; background: #fff; flex-direction: column; align-items: stretch; padding: 16px 24px 28px; border-bottom: 1px solid var(--line); max-height: calc(100vh - 72px); overflow: auto; }
    .menu-toggle:checked ~ .nav { display: flex; }
    .panel { display: block; position: static; border: 0; box-shadow: none; padding: 0 0 8px 12px; min-width: 0; }
    .panel span { display: none; }
    .right { margin: 16px 0 0; flex-wrap: wrap; }
  }
  .foot { background: var(--soft); padding: 64px 0; }
  .foot-in { display: flex; flex-wrap: wrap; gap: 40px 56px; }
  .foot-in > div { flex: 1 1 150px; }
  .foot-in > .about { flex: 2 1 300px; }
  .foot h4 { font-size: 1rem; margin-bottom: .8em; }
  .foot ul { list-style: none; padding: 0; margin: 0; }
  .foot li { margin: .45em 0; }
  .foot a { text-decoration: none; color: var(--grey); font-size: .92rem; }
  .foot a:hover { color: var(--ink); }
  .about img { height: 20px; width: auto; margin-bottom: 14px; }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found | VOOL" description="This page does not exist.">
  <section class="section">
    <div class="wrap" style="max-width:720px">
      <span class="eyebrow">404</span>
      <h1>This page has moved or never existed</h1>
      <p class="lead">Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn" href="/">Home</a>
        <a class="btn ghost" href="/get-a-quote/">Get a quote</a>
        <a class="btn ghost" href="/where-to-buy/">Find an installer</a>
        <a class="btn ghost" href="/resources/help-center/">Help Center</a>
      </div>
    </div>
  </section>
</Base>

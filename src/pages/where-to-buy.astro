---
import Base from '../layouts/Base.astro';
import countries from '../content/partners.json';
import { RESELLER_URL } from '../content/ui';
const total = countries.reduce((n, c) => n + c.partners.length, 0);
---
<Base lang="en" title="Find a VOOL installer or reseller" description="Find a VOOL reseller, energy company or installer near you.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Find an installer</span>
      <h1>Find an installer or reseller near you</h1>
      <p class="lead">VOOL is sold and installed by retailers, energy companies and installers in {countries.length} countries.</p>
      <div id="map" class="map" aria-label="Map of countries with VOOL partners"></div>
      <div class="filters" role="group" aria-label="Filter partners">
        <input type="search" placeholder="Search by name or country" aria-label="Search partners" data-search />
        <button class="on" data-filter="all">All</button>
        <button data-filter="installer">Installers</button>
        <button data-filter="wholesaler">Wholesalers</button>
        <select aria-label="Country" data-country>
          <option value="">All countries</option>
          {countries.map((c) => <option value={c.country}>{c.country}</option>)}
        </select>
      </div>
      {countries.map((c) => (
        <div class="country" data-name={c.country}>
          <h2>{c.country}</h2>
          <div class="grid c3">
            {c.partners.map((p) => (
              <div class="card partner" data-installer={String(p.installer)} data-wholesaler={String(p.wholesaler)}>
                <h3>{p.name}</h3>
                <p class="tags">{p.installer && <span class="badge">Installer</span>} {p.wholesaler && <span class="badge">Wholesaler</span>}</p>
                {p.website && <a href={p.website} rel="noopener" aria-label={`${p.name} website`}>{p.website.replace(/^https?:\/\/(www\.)?/, '').split('/')[0]} ↗</a>}
                {p.phone && <a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a>}
                {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
              </div>
            ))}
          </div>
          {c.partners.length > 6 && <button class="more-btn" type="button" data-more>Show all {c.partners.length} in {c.country}</button>}
        </div>
      ))}
    </div>
  </section>
  <section class="section dark">
    <div class="wrap" style="display:flex;gap:24px;justify-content:space-between;align-items:center;flex-wrap:wrap">
      <div><h2>Do you sell or install chargers?</h2><p class="lead">Partners see stock and their own prices and order online.</p></div>
      <div class="btn-row" style="margin:0"><a class="btn" href="/resources/resellers/">Become a partner</a><a class="btn ghost" style="color:#fff" href={RESELLER_URL}>Reseller login</a></div>
    </div>
  </section>
</Base>

<script>
  const state = { filter: 'all', country: '', q: '' };
  const apply = () => {
    document.querySelectorAll<HTMLElement>('.country').forEach((c) => {
      let shown = 0;
      c.querySelectorAll<HTMLElement>('.partner').forEach((p) => {
        const ok = (state.filter === 'all' || p.dataset[state.filter] === 'true') && (!state.q || (p.textContent + ' ' + c.dataset.name).toLowerCase().includes(state.q));
        p.hidden = !ok; if (ok) shown++;
      });
      c.hidden = shown === 0 || (state.country !== '' && c.dataset.name !== state.country);
      // With every country on screen, show six per country until asked for more.
      c.classList.toggle('short', state.country === '' && !state.q && !c.dataset.all);
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    state.filter = b.dataset.filter!;
    document.querySelectorAll('[data-filter]').forEach((x) => x.classList.toggle('on', x === b));
    apply();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((b) => b.addEventListener('click', () => { b.closest<HTMLElement>('.country')!.dataset.all = '1'; apply(); }));
  const sel = document.querySelector<HTMLSelectElement>('[data-country]')!;
  sel.addEventListener('change', () => { state.country = sel.value; apply(); });
  document.querySelector<HTMLInputElement>('[data-search]')?.addEventListener('input', (e) => { state.q = (e.target as HTMLInputElement).value.trim().toLowerCase(); apply(); });
  // Start with the visitor's own country when we have partners there; "All countries" stays one click away.
  const BY_LANG: Record<string, string> = { et: 'Estonia', lv: 'Latvia', lt: 'Lithuania', fi: 'Finland', sv: 'Sweden', nb: 'Norway', no: 'Norway', da: 'Denmark', de: 'Germany', pl: 'Poland', pt: 'Portugal', fr: 'France', it: 'Italy', es: 'Spain', sk: 'Slovakia', nl: 'Netherlands', is: 'Iceland', cs: 'Czech Republic' };
  const BY_REGION: Record<string, string> = { EE: 'Estonia', LV: 'Latvia', LT: 'Lithuania', FI: 'Finland', SE: 'Sweden', NO: 'Norway', DK: 'Denmark', DE: 'Germany', AT: 'Austria', CH: 'Switzerland', PL: 'Poland', PT: 'Portugal', FR: 'France', IT: 'Italy', ES: 'Spain', SK: 'Slovakia', NL: 'Netherlands', BE: 'Belgium', LU: 'Luxembourg', IS: 'Iceland', CZ: 'Czech Republic', IE: 'Ireland', GB: 'United Kingdom' };
  const [l, r] = (navigator.language || '').split('-');
  const guess = BY_REGION[(r || '').toUpperCase()] || BY_LANG[l];
  if (guess && [...sel.options].some((o) => o.value === guess)) { sel.value = guess; state.country = guess; apply(); }
  const type = new URLSearchParams(location.search).get('type');
  apply();
  if (type) document.querySelector<HTMLButtonElement>(`[data-filter="${type}"]`)?.click();

  // Map: one marker per country, sized by the number of partners. The list below works without it.
  const CENTRES: Record<string, [number, number]> = { Austria: [47.6, 14.1], Belgium: [50.6, 4.6], Croatia: [45.1, 15.2], 'Czech Republic': [49.8, 15.5], Denmark: [56.0, 9.5], Estonia: [58.7, 25.5], Finland: [62.0, 26.0], France: [46.6, 2.4], Germany: [51.0, 10.3], Greece: [39.0, 22.0], Hungary: [47.2, 19.4], Iceland: [64.9, -18.6], Ireland: [53.2, -8.0], Italy: [42.8, 12.5], Latvia: [56.9, 24.6], Lithuania: [55.3, 23.9], Luxembourg: [49.8, 6.1], Malta: [35.9, 14.4], Netherlands: [52.2, 5.3], Norway: [61.0, 9.0], Poland: [52.0, 19.3], Portugal: [39.6, -8.0], Slovakia: [48.7, 19.5], Slovenia: [46.1, 14.8], Spain: [40.2, -3.6], Sweden: [60.5, 15.5], Switzerland: [46.8, 8.2], 'United Kingdom': [53.5, -1.8] };
  const mapEl = document.getElementById('map')!;
  const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.append(css);
  const js = document.createElement('script'); js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  js.onerror = () => { mapEl.hidden = true; };
  js.onload = () => {
    const L = (window as any).L;
    const map = L.map(mapEl, { scrollWheelZoom: false }).setView([55, 12], 4);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 8, attribution: '© OpenStreetMap contributors' }).addTo(map);
    document.querySelectorAll<HTMLElement>('.country').forEach((c) => {
      const at = CENTRES[c.dataset.name!]; if (!at) return;
      const n = c.querySelectorAll('.partner').length;
      L.circleMarker(at, { radius: 8 + Math.min(14, Math.sqrt(n) * 3), color: '#eb4e20', fillColor: '#eb4e20', fillOpacity: 0.85, weight: 0 })
        .addTo(map).bindTooltip(`${c.dataset.name}: ${n}`)
        .on('click', () => { sel.value = c.dataset.name!; state.country = sel.value; apply(); c.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    });
  };
  document.head.append(js);
</script>

<style>
  .map { height: 380px; border-radius: var(--radius); margin-top: 28px; background: var(--soft); z-index: 0; }
  .map[hidden] { display: none; }
  .filters input[type=search] { font: inherit; font-size: 16px; padding: .55em 1.1em; border-radius: 999px; border: 1px solid var(--field); min-width: 240px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 28px 0 8px; }
  .filters button, .filters select { font: inherit; padding: .55em 1.1em; border-radius: 999px; border: 1px solid var(--field); background: #fff; cursor: pointer; }
  .filters button.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .country { margin-top: 44px; }
  .country.short .partner:nth-child(n+7) { display: none; }
  .more-btn { display: none; margin-top: 16px; font: inherit; font-weight: 500; padding: .7em 1.3em; min-height: 46px; border-radius: 999px; border: 1px solid var(--field); background: #fff; cursor: pointer; }
  .country.short .more-btn { display: inline-block; }
  .more-btn:hover { border-color: var(--ink); }
  .country[hidden], .partner[hidden] { display: none; }
  .country h2 { font-size: 1.5rem; margin-bottom: 16px; }
  .partner { display: flex; flex-direction: column; gap: 4px; padding: 22px; }
  .partner h3 { font-size: 1.1rem; margin: 0; }
  .partner a { color: var(--grey); text-decoration: none; font-size: .92rem; word-break: break-word; padding: 7px 0; }
  .partner a:first-of-type { color: var(--orange-text); font-weight: 500; }
  @media (max-width: 760px) { .partner a { padding: 11px 0; } .filters button, .filters select, .filters input[type=search] { min-height: 46px; } }
  .partner a:hover { color: var(--orange); }
  .tags { margin: 2px 0 6px; min-height: 1.4em; }
</style>
